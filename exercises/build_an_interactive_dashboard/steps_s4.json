{
  "exercise": "build_an_interactive_dashboard",
  "version": 3,
  "source_doc": "Exercises/Build_an_Interactive_Dashboard.docx > Instructions, Part 1 steps 1-3 (find your data)",
  "audience": "public",
  "variables": {
    "repo": "<YOUR_GITHUB_ACCOUNT>/my-agentic-workshop",
    "codespace_name": "<CODESPACE_NAME>",
    "codespace_display": "<CODESPACE_DISPLAY_NAME>"
  },
  "steps": [
    {
      "id": "p1.01",
      "manual_step": 1,
      "part": 1,
      "segment": "scripted",
      "action": {
        "type": "navigate",
        "url": "https://github.com/codespaces"
      },
      "expect": {
        "kind": "visible",
        "tab": "github",
        "frame": "main",
        "locator": "text=Your codespaces",
        "timeout_s": 20
      },
      "narration": {
        "line_id": "dash.p1.01",
        "text": "Start at github.com/codespaces. A codespace is a complete development workspace that runs in your browser, so there's nothing to install.",
        "cue_word": null,
        "status": "approved",
        "source": "clone"
      },
      "dwell": {
        "min_s": 2.0
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "github.com/codespaces",
          "target": {
            "chrome": "address_bar",
            "match": "github.com/codespaces"
          }
        }
      ]
    },
    {
      "id": "p1.02",
      "manual_step": 2,
      "part": 1,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "github",
          "frame": "main",
          "locator": "a[href^='/codespaces?repository_id=']",
          "fallback": [
            "a:has-text('{repo}')"
          ]
        }
      },
      "expect": {
        "kind": "url_contains",
        "tab": "github",
        "value": "repository_id=",
        "timeout_s": 15
      },
      "narration": {
        "line_id": "dash.p1.02",
        "text": "On the left, under By repository, click your repository, my-agentic-workshop. The list narrows to that repository's codespaces.",
        "cue_word": "click",
        "click_word": "my-agentic-workshop",
        "status": "approved",
        "source": "clone",
        "labels": [
          "By repository"
        ]
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "my-agentic-workshop",
          "target": {
            "of": "action"
          }
        }
      ]
    },
    {
      "id": "p1.03",
      "manual_step": 3,
      "part": 1,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "github",
          "frame": "main",
          "locator": "a[href='/codespaces/{codespace_name}']"
        }
      },
      "expect": {
        "kind": "visible",
        "tab": "ide",
        "frame": "main",
        "locator": ".explorer-folders-view .monaco-list-row[aria-label='data']",
        "timeout_s": 90
      },
      "narration": {
        "line_id": "dash.p1.03",
        "text": "Then click your codespace. GitHub gives every codespace a random two-word name. This one is called {codespace_display}. Yours will have a different name, something like jubilant waffle.",
        "cue_word": "click",
        "click_word": "codespace",
        "status": "approved",
        "source": "clone"
      },
      "dwell": {
        "min_s": 3.0
      },
      "notes": "Opens in a new tab (the link has target=_blank). Codespaces occasionally stalls on 'Setting up your codespace'; the runner reloads once after 90 s. A stopped codespace takes about a minute to start; that wait is cut in the edit.",
      "on_fail": "retry_once",
      "marks": [
        {
          "kind": "arrow",
          "at_word": "codespace",
          "target": {
            "of": "action"
          }
        },
        {
          "kind": "arrow",
          "at_word": "{codespace_display}",
          "target": {
            "tab": "ide",
            "frame": "main",
            "locator": "#status\\.host",
            "match": "{codespace_display}",
            "ocr_band": [
              0.9,
              1.0
            ]
          },
          "until_word": "waffle"
        }
      ]
    },
    {
      "id": "p1.04",
      "manual_step": 4,
      "part": 1,
      "segment": "scripted",
      "only_if": {
        "tab": "ide",
        "locator": ".monaco-dialog-box:has-text('trust the authors')",
        "state": "visible",
        "timeout_s": 2,
        "otherwise": "skip"
      },
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".monaco-dialog-box .monaco-button:has-text('Trust Folder')",
          "fallback": [
            "text=Trust Folder & Continue"
          ]
        }
      },
      "expect": {
        "kind": "hidden",
        "tab": "ide",
        "frame": "main",
        "locator": ".monaco-dialog-box",
        "timeout_s": 10
      },
      "narration": {
        "line_id": "dash.p1.04",
        "text": "If a box asks whether you trust the authors of these files, click Trust Folder & Continue. It's your own repository, so that's safe.",
        "cue_word": "click",
        "click_word": "Trust",
        "status": "approved",
        "source": "clone",
        "labels": [
          "Trust Folder & Continue"
        ]
      },
      "notes": "Appears only on a codespace's first open. The take's existing codespace is already trusted, so this step is skipped there; a fresh take repo shows it."
    },
    {
      "id": "p1.05",
      "manual_step": 6,
      "part": 1,
      "segment": "scripted",
      "only_if": {
        "tab": "ide",
        "locator": ".explorer-folders-view",
        "state": "hidden",
        "timeout_s": 1,
        "otherwise": "skip"
      },
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".activitybar a[aria-label^='Explorer']"
        }
      },
      "expect": {
        "kind": "visible",
        "tab": "ide",
        "frame": "main",
        "locator": ".explorer-folders-view .monaco-list-row[aria-label='data']",
        "timeout_s": 10
      },
      "narration": {
        "line_id": "dash.p1.05",
        "text": "If the file list isn't showing, click the Explorer icon at the top of the bar on the far left.",
        "cue_word": "click",
        "click_word": "Explorer",
        "status": "approved",
        "source": "clone"
      },
      "notes": "Clicking Explorer while it is open would close it, so the step runs only when the file list is hidden."
    },
    {
      "id": "p1.06a",
      "manual_step": 6,
      "part": 1,
      "segment": "scripted",
      "only_if": {
        "tab": "ide",
        "locator": ".explorer-folders-view .monaco-list-row[aria-label='data'][aria-expanded='false']",
        "state": "visible",
        "timeout_s": 2,
        "otherwise": "stop_take"
      },
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".explorer-folders-view .monaco-list-row[aria-label='data']"
        }
      },
      "expect": {
        "kind": "visible",
        "tab": "ide",
        "frame": "main",
        "locator": ".explorer-folders-view .monaco-list-row[aria-label='monthlysummary.csv']",
        "timeout_s": 10
      },
      "narration": {
        "line_id": "dash.p1.06a",
        "text": "The Explorer, on the left, lists the files in your repository. Open the data folder,",
        "cue_word": "Open",
        "click_word": "data",
        "status": "approved",
        "source": "clone"
      },
      "notes": "A click on an expanded folder collapses it, so the take stops if data is already open (prepare resets it)."
    },
    {
      "id": "p1.06b",
      "manual_step": 6,
      "part": 1,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".explorer-folders-view .monaco-list-row[aria-label='monthlysummary.csv']"
        }
      },
      "expect": {
        "kind": "visible",
        "tab": "ide",
        "frame": "main",
        "locator": ".tabs-container .tab:has-text('monthlysummary.csv')",
        "timeout_s": 15
      },
      "narration": {
        "line_id": "dash.p1.06b",
        "text": "and select monthlysummary.csv. The first line lists the columns, from location and airport code to delays, cancellations and taxi times. Each row after that is one airport in one month, about twenty-four thousand rows in all.",
        "cue_word": "select",
        "click_word": "monthlysummary.csv",
        "status": "approved",
        "source": "clone"
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "first",
          "target": {
            "tab": "ide",
            "frame": "main",
            "locator": ".monaco-editor .view-lines .view-line",
            "pick": "topmost"
          }
        }
      ],
      "dwell": {
        "min_s": 3.0
      }
    },
    {
      "id": "p1.06c",
      "manual_step": 6,
      "part": 1,
      "segment": "scripted",
      "only_if": {
        "tab": "ide",
        "locator": ".notifications-toasts .notification-toast:has-text('Rainbow CSV')",
        "state": "visible",
        "timeout_s": 1,
        "otherwise": "skip"
      },
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".notifications-toasts .notification-toast:has-text('Rainbow CSV') .codicon-notifications-clear",
          "fallback": [
            ".notifications-toasts .notification-toast:has-text('Rainbow CSV') a[aria-label^='Clear']"
          ]
        }
      },
      "expect": {
        "kind": "hidden",
        "tab": "ide",
        "frame": "main",
        "locator": ".notifications-toasts .notification-toast:has-text('Rainbow CSV')",
        "timeout_s": 5
      },
      "narration": {
        "line_id": "dash.p1.06c",
        "text": "If a notice offers to install the Rainbow CSV extension, close it with the X. You won't need it.",
        "cue_word": "close",
        "click_word": "X",
        "status": "approved",
        "source": "clone"
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "notice",
          "target": {
            "of": "subject"
          }
        }
      ]
    }
  ],
  "prepare": {
    "ide": {
      "close_editors": true,
      "collapse_explorer": true,
      "notes": "Off camera, before OBS starts: VS Code saves open editors and folder expansion in the codespace, so the previous take's state (data expanded, the CSV open) is reset first."
    }
  }
}
