{
  "exercise": "build_an_interactive_dashboard",
  "version": 4,
  "source_doc": "Exercises/Build_an_Interactive_Dashboard.docx > Instructions, Part 1 and Part 2 steps 7-8 (S6 test take)",
  "audience": "public",
  "variables": {
    "repo": "<YOUR_GITHUB_ACCOUNT>/my-agentic-workshop-take07",
    "codespace_name": "<CODESPACE_NAME>",
    "codespace_display": "<CODESPACE_DISPLAY_NAME>",
    "feedback_prompt": "@generated",
    "repo_id": "<GITHUB_REPO_ID>"
  },
  "steps": [
    {
      "id": "p1.01",
      "manual_step": 1,
      "part": 1,
      "segment": "scripted",
      "action": {
        "type": "navigate",
        "url": "https://github.com/codespaces"
      },
      "expect": {
        "kind": "visible",
        "tab": "github",
        "frame": "main",
        "locator": "text=Your codespaces",
        "timeout_s": 20
      },
      "narration": {
        "line_id": "dash.p1.01",
        "text": "I'll start at github.com/codespaces. A codespace is a complete development workspace that runs in your browser, so there's nothing to install.",
        "cue_word": null,
        "status": "approved",
        "source": "clone"
      },
      "dwell": {
        "min_s": 2.0
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "github.com/codespaces",
          "target": {
            "chrome": "address_bar",
            "match": "github.com/codespaces"
          }
        }
      ]
    },
    {
      "id": "p1.02",
      "manual_step": 2,
      "part": 1,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "github",
          "frame": "main",
          "locator": "a[href='/codespaces?repository_id={repo_id}']",
          "fallback": [
            "a[href^='/codespaces?repository_id=']:has-text('{repo}')"
          ]
        }
      },
      "expect": {
        "kind": "url_contains",
        "tab": "github",
        "value": "repository_id={repo_id}",
        "timeout_s": 15
      },
      "narration": {
        "line_id": "dash.p1.02",
        "text": "On the left, under By repository, I'll click my repository, my-agentic-workshop. As you can see, the list narrows to that repository's codespaces.",
        "cue_word": "click",
        "click_word": "my-agentic-workshop",
        "status": "approved",
        "source": "clone",
        "labels": [
          "By repository"
        ]
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "my-agentic-workshop",
          "target": {
            "of": "action"
          }
        }
      ],
      "notes": "Matched by repository id: by name, my-agentic-workshop is a prefix of every take repo (take02 of S6 clicked take06's link, 2026-10-07)."
    },
    {
      "id": "p1.03",
      "manual_step": 3,
      "part": 1,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "github",
          "frame": "main",
          "locator": "a[href='/codespaces/{codespace_name}']"
        }
      },
      "expect": {
        "kind": "visible",
        "tab": "ide",
        "frame": "main",
        "locator": ".explorer-folders-view .monaco-list-row[aria-label='data']",
        "timeout_s": 90
      },
      "narration": {
        "line_id": "dash.p1.03",
        "text": "Then I'll click my codespace. GitHub gives every codespace a random two-word name. This one is called {codespace_display}. Yours will have a different name.",
        "cue_word": "click",
        "click_word": "codespace",
        "status": "approved",
        "source": "clone"
      },
      "dwell": {
        "min_s": 3.0
      },
      "notes": "Opens in a new tab (the link has target=_blank). Codespaces occasionally stalls on 'Setting up your codespace'; the runner reloads once after 90 s. A stopped codespace takes about a minute to start; that wait is cut in the edit.",
      "on_fail": "retry_once",
      "marks": [
        {
          "kind": "arrow",
          "at_word": "codespace",
          "target": {
            "of": "action"
          }
        },
        {
          "kind": "arrow",
          "at_word": "{codespace_display}",
          "target": {
            "tab": "ide",
            "frame": "main",
            "locator": "#status\\.host",
            "match": "{codespace_display}",
            "ocr_band": [
              0.9,
              1.0
            ]
          },
          "until_word": "name"
        }
      ]
    },
    {
      "id": "p1.04",
      "manual_step": 4,
      "part": 1,
      "segment": "scripted",
      "only_if": {
        "tab": "ide",
        "locator": ".monaco-dialog-box:has-text('trust the authors')",
        "state": "visible",
        "timeout_s": 2,
        "otherwise": "skip"
      },
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".monaco-dialog-box .monaco-button:has-text('Trust Folder')",
          "fallback": [
            "text=Trust Folder & Continue"
          ]
        }
      },
      "expect": {
        "kind": "hidden",
        "tab": "ide",
        "frame": "main",
        "locator": ".monaco-dialog-box",
        "timeout_s": 10
      },
      "narration": {
        "line_id": "dash.p1.04",
        "text": "A box asks whether I trust the authors of the files in this folder. It's my own repository, so I'll click Trust Folder & Continue.",
        "cue_word": "click",
        "click_word": "Trust",
        "status": "approved",
        "source": "clone",
        "labels": [
          "Trust Folder & Continue"
        ]
      },
      "notes": "Appears only on a codespace's first open. The take's existing codespace is already trusted, so this step is skipped there; a fresh take repo shows it."
    },
    {
      "id": "p1.05",
      "manual_step": 5,
      "part": 1,
      "segment": "scripted",
      "only_if": {
        "tab": "ide",
        "locator": ".explorer-folders-view",
        "state": "hidden",
        "timeout_s": 1,
        "otherwise": "skip"
      },
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".activitybar a[aria-label^='Explorer']"
        }
      },
      "expect": {
        "kind": "visible",
        "tab": "ide",
        "frame": "main",
        "locator": ".explorer-folders-view .monaco-list-row[aria-label='data']",
        "timeout_s": 10
      },
      "narration": {
        "line_id": "dash.p1.05",
        "text": "The file list isn't showing, so I'll click the Explorer icon at the top of the bar on the far left.",
        "cue_word": "click",
        "click_word": "Explorer",
        "status": "approved",
        "source": "clone"
      },
      "notes": "Clicking Explorer while it is open would close it, so the step runs only when the file list is hidden."
    },
    {
      "id": "p1.06a",
      "manual_step": 6,
      "part": 1,
      "segment": "scripted",
      "only_if": {
        "tab": "ide",
        "locator": ".explorer-folders-view .monaco-list-row[aria-label='data'][aria-expanded='false']",
        "state": "visible",
        "timeout_s": 2,
        "otherwise": "stop_take"
      },
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".explorer-folders-view .monaco-list-row[aria-label='data']"
        }
      },
      "expect": {
        "kind": "visible",
        "tab": "ide",
        "frame": "main",
        "locator": ".explorer-folders-view .monaco-list-row[aria-label='monthlysummary.csv']",
        "timeout_s": 10
      },
      "narration": {
        "line_id": "dash.p1.06a",
        "text": "The Explorer, on the left, lists the files in the repository. I'll open the data folder,",
        "cue_word": "open",
        "click_word": "data",
        "status": "approved",
        "source": "clone"
      },
      "notes": "A click on an expanded folder collapses it, so the take stops if data is already open (prepare resets it)."
    },
    {
      "id": "p1.06b",
      "manual_step": 6,
      "part": 1,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".explorer-folders-view .monaco-list-row[aria-label='monthlysummary.csv']"
        }
      },
      "expect": {
        "kind": "visible",
        "tab": "ide",
        "frame": "main",
        "locator": ".tabs-container .tab:has-text('monthlysummary.csv')",
        "timeout_s": 15
      },
      "narration": {
        "line_id": "dash.p1.06b",
        "text": "and select monthlysummary.csv. The first line lists the columns, from location and airport code to delays, cancellations and taxi times. Each row after that is one airport in one month, about twenty-four thousand rows in all.",
        "cue_word": "select",
        "click_word": "monthlysummary.csv",
        "status": "approved",
        "source": "clone"
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "first",
          "target": {
            "tab": "ide",
            "frame": "main",
            "locator": ".monaco-editor .view-lines .view-line",
            "pick": "topmost"
          }
        }
      ],
      "dwell": {
        "min_s": 3.0
      }
    },
    {
      "id": "p1.06c",
      "manual_step": 6,
      "part": 1,
      "segment": "scripted",
      "only_if": {
        "tab": "ide",
        "locator": ".notifications-toasts .notification-toast:has-text('Rainbow CSV')",
        "state": "visible",
        "timeout_s": 1,
        "otherwise": "skip"
      },
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".notifications-toasts .notification-toast:has-text('Rainbow CSV') .codicon-notifications-clear",
          "fallback": [
            ".notifications-toasts .notification-toast:has-text('Rainbow CSV') a[aria-label^='Clear']"
          ]
        }
      },
      "expect": {
        "kind": "hidden",
        "tab": "ide",
        "frame": "main",
        "locator": ".notifications-toasts .notification-toast:has-text('Rainbow CSV')",
        "timeout_s": 5
      },
      "narration": {
        "line_id": "dash.p1.06c",
        "text": "A notice offers to install the Rainbow CSV extension. We won't need it, so I'll close it with the X.",
        "cue_word": "close",
        "click_word": "X",
        "status": "approved",
        "source": "clone"
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "notice",
          "target": {
            "of": "subject"
          }
        }
      ]
    },
    {
      "id": "p2.07a",
      "manual_step": 7,
      "part": 2,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".part.auxiliarybar .composite-bar a[aria-label=\"Claude Code\"]"
        }
      },
      "expect": {
        "kind": "visible",
        "tab": "ide",
        "frame": "claude_panel",
        "locator": "[contenteditable][aria-label=\"Message input\"]",
        "timeout_s": 15
      },
      "narration": {
        "line_id": "dash.p2.07a",
        "text": "Claude Code lives in the panel on the right-hand side of the screen. I'll click the Claude Code tab.",
        "cue_word": "click",
        "click_word": "tab",
        "status": "approved",
        "source": "clone"
      },
      "only_if": {
        "tab": "ide",
        "locator": ".part.auxiliarybar .composite-bar a[aria-label=\"Claude Code\"]",
        "state": "visible",
        "timeout_s": 2,
        "otherwise": "skip"
      },
      "notes": "When the codespace already shows a Claude Code tab next to Chat: after a restart it does (take06, 2026-10-07). On a codespace's very first open it doesn't, so p2.07b and c run instead."
    },
    {
      "id": "p2.07b",
      "manual_step": 7,
      "part": 2,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".part.auxiliarybar [aria-label=\"Additional Views\"]"
        }
      },
      "expect": {
        "kind": "visible",
        "tab": "ide",
        "frame": "main",
        "locator": ".context-view >> text=\"Claude Code\"",
        "timeout_s": 5
      },
      "narration": {
        "line_id": "dash.p2.07b",
        "text": "Claude Code lives in the panel on the right-hand side of the screen. As of this writing, a new codespace doesn't show a Claude Code tab, so I'll click the three dots next to Chat,",
        "cue_word": "click",
        "click_word": "three",
        "status": "approved",
        "source": "clone",
        "labels": [
          "Chat"
        ]
      },
      "only_if": {
        "tab": "ide",
        "locator": ".part.auxiliarybar .composite-bar a[aria-label=\"Claude Code\"]",
        "state": "hidden",
        "timeout_s": 2,
        "otherwise": "skip"
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "three",
          "target": {
            "of": "action"
          }
        }
      ]
    },
    {
      "id": "p2.07c",
      "manual_step": 7,
      "part": 2,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "main",
          "locator": ".context-view >> text=\"Claude Code\"",
          "fallback": [
            "role=menuitem[name=\"Claude Code\"]",
            "text=Claude Code"
          ]
        }
      },
      "expect": {
        "kind": "visible",
        "tab": "ide",
        "frame": "claude_panel",
        "locator": "[contenteditable][aria-label=\"Message input\"]",
        "timeout_s": 15
      },
      "narration": {
        "line_id": "dash.p2.07c",
        "text": "and choose Claude Code. Notice that the Chat tab next to it is GitHub Copilot, a different assistant. We're using Claude Code in this video.",
        "cue_word": "choose",
        "click_word": "Claude",
        "status": "approved",
        "source": "clone",
        "labels": [
          "Chat"
        ]
      },
      "only_if": {
        "tab": "ide",
        "locator": ".context-view >> text=\"Claude Code\"",
        "state": "visible",
        "timeout_s": 2,
        "otherwise": "skip"
      },
      "dwell": {
        "min_s": 1.5
      }
    },
    {
      "id": "p2.07d",
      "manual_step": 7,
      "part": 2,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "claude_panel",
          "locator": "button[aria-label=\"Hide onboarding\"]"
        }
      },
      "expect": {
        "kind": "hidden",
        "tab": "ide",
        "frame": "claude_panel",
        "locator": "button[aria-label=\"Hide onboarding\"]",
        "timeout_s": 5
      },
      "narration": {
        "line_id": "dash.p2.07d",
        "text": "Claude Code opens with two welcome cards. We won't need them, so I'll close Learn Claude Code with its X,",
        "cue_word": "close",
        "click_word": "X",
        "status": "approved",
        "source": "clone",
        "labels": [
          "Learn Claude Code"
        ]
      },
      "zoom": {
        "max": 2
      },
      "only_if": {
        "tab": "ide",
        "frame": "claude_panel",
        "locator": "button[aria-label=\"Hide onboarding\"]",
        "state": "visible",
        "timeout_s": 4,
        "otherwise": "skip"
      },
      "notes": "The doc's welcome cards, shown once Claude Code is logged in (take06, 2026-10-07): 'Learn Claude Code' closes with its Hide onboarding X; 'Auto mode is now Claude Code's default permission mode.' with its Close X."
    },
    {
      "id": "p2.07e",
      "manual_step": 7,
      "part": 2,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "claude_panel",
          "locator": "button[aria-label=\"Close\"]"
        }
      },
      "expect": {
        "kind": "hidden",
        "tab": "ide",
        "frame": "claude_panel",
        "locator": "text=/Auto mode is now/",
        "timeout_s": 5
      },
      "narration": {
        "line_id": "dash.p2.07e",
        "text": "and then Auto mode.",
        "cue_word": "then",
        "click_word": "Auto",
        "status": "approved",
        "source": "clone",
        "labels": [
          "Auto mode"
        ]
      },
      "zoom": {
        "max": 2
      },
      "only_if": {
        "tab": "ide",
        "frame": "claude_panel",
        "locator": "text=/Auto mode is now/",
        "state": "visible",
        "timeout_s": 4,
        "otherwise": "skip"
      },
      "notes": "The doc's welcome cards, shown once Claude Code is logged in (take06, 2026-10-07): 'Learn Claude Code' closes with its Hide onboarding X; 'Auto mode is now Claude Code's default permission mode.' with its Close X."
    },
    {
      "id": "p2.08a",
      "manual_step": 8,
      "part": 2,
      "segment": "scripted",
      "action": {
        "type": "type",
        "typing_mode": "full",
        "target": {
          "tab": "ide",
          "frame": "claude_panel",
          "locator": "[contenteditable][aria-label=\"Message input\"]"
        },
        "text": "Before we build anything, add two rules to CLAUDE.md:\n- Keep this file short. When we finish a piece of work, write notes about it in a file in the docs folder, and add a one-line pointer to that file here.\n- When I ask you to commit, commit to the main branch and push it to GitHub. Don't create other branches."
      },
      "expect": {
        "kind": "text_in_frame",
        "tab": "ide",
        "frame": "claude_panel",
        "value": ". Don't create other branches.",
        "timeout_s": 5
      },
      "narration": {
        "line_id": "dash.p2.08a",
        "text": "Before we build anything, I'll give Claude two standing rules. I'll enter this prompt. Every prompt in this video is available via the description.",
        "cue_word": "enter",
        "click_word": null,
        "status": "approved",
        "source": "clone"
      },
      "zoom": {
        "max": 2
      },
      "notes": "Typed at natural speed, not pasted (R67): the edit speeds the typing up or cuts its middle, so the line plays over the finished prompt. The description carries every prompt."
    },
    {
      "id": "p2.08b",
      "manual_step": 8,
      "part": 2,
      "segment": "scripted",
      "action": {
        "type": "none"
      },
      "expect": {
        "kind": "none"
      },
      "narration": {
        "line_id": "dash.p2.08b",
        "text": "These rules go in CLAUDE.md, a file that Claude reads at the start of every session, so they apply from now on.",
        "cue_word": null,
        "click_word": null,
        "status": "approved",
        "source": "clone"
      },
      "zoom": {
        "max": 2
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "CLAUDE.md",
          "target": {
            "tab": "ide",
            "frame": "claude_panel",
            "locator": "[contenteditable][aria-label=\"Message input\"]",
            "match": "CLAUDE.md"
          }
        }
      ]
    },
    {
      "id": "p2.08c",
      "manual_step": 8,
      "part": 2,
      "segment": "scripted",
      "action": {
        "type": "none"
      },
      "expect": {
        "kind": "none"
      },
      "narration": {
        "line_id": "dash.p2.08c",
        "text": "The first rule keeps that file short. On a long project, notes pile up, and Claude would read all of them every time.",
        "cue_word": null,
        "click_word": null,
        "status": "approved",
        "source": "clone"
      },
      "zoom": {
        "max": 2
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "short",
          "target": {
            "tab": "ide",
            "frame": "claude_panel",
            "locator": "[contenteditable][aria-label=\"Message input\"]",
            "match": "Keep this file short."
          }
        }
      ]
    },
    {
      "id": "p2.08d",
      "manual_step": 8,
      "part": 2,
      "segment": "scripted",
      "action": {
        "type": "none"
      },
      "expect": {
        "kind": "none"
      },
      "narration": {
        "line_id": "dash.p2.08d",
        "text": "The second rule keeps our work on the main branch, which GitHub shows on the repository's front page. Without it, Claude may save the work on a separate branch.",
        "cue_word": null,
        "click_word": null,
        "status": "approved",
        "source": "clone"
      },
      "zoom": {
        "max": 2
      },
      "marks": [
        {
          "kind": "rect",
          "at_word": "main",
          "target": {
            "tab": "ide",
            "frame": "claude_panel",
            "locator": "[contenteditable][aria-label=\"Message input\"]",
            "match": "commit to the main branch"
          }
        }
      ]
    },
    {
      "id": "p2.08e",
      "manual_step": 8,
      "part": 2,
      "segment": "scripted",
      "action": {
        "type": "click",
        "target": {
          "tab": "ide",
          "frame": "claude_panel",
          "locator": "button[aria-label=\"Send message\"]"
        }
      },
      "expect": {
        "kind": "text_in_frame",
        "tab": "ide",
        "frame": "claude_panel",
        "value": "Queue another message",
        "timeout_s": 10
      },
      "narration": {
        "line_id": "dash.p2.08e",
        "text": "I'll click the send arrow. As you can see, the prompt moves into the conversation.",
        "cue_word": "click",
        "click_word": "send",
        "status": "approved",
        "source": "clone"
      },
      "zoom": {
        "max": 2
      },
      "notes": "Send arrow confirmed in take06 (2026-10-07). The busy panel shows 'Queue another message'."
    }
  ],
  "prepare": {
    "ide": {
      "close_editors": true,
      "collapse_explorer": true,
      "notes": "Off camera, before OBS starts: VS Code saves open editors and folder expansion in the codespace, so the previous take's state (data expanded, the CSV open) is reset first."
    }
  }
}
