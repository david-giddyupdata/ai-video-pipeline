<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- AIDV for Premiere Pro (R102): the "AIDV" panel (Window > Extensions) and a hidden bridge that starts with
     Premiere. Both run the ExtendScript in jsx/aidv.jsx; the bridge also takes ExtendScript from the pipeline over
     localhost (pipeline/edit/ppro/bridge.py). Unsigned: needs PlayerDebugMode=1 under HKCU\Software\Adobe\CSXS.12. -->
<ExtensionManifest ExtensionBundleId="com.giddyup.aidv" ExtensionBundleName="AIDV" ExtensionBundleVersion="1.0.0" Version="7.0">
  <ExtensionList>
    <Extension Id="com.giddyup.aidv.panel" Version="1.0.0"/>
    <Extension Id="com.giddyup.aidv.bridge" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[25.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.giddyup.aidv.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/aidv.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>AIDV</Menu>
          <Geometry>
            <Size>
              <Height>220</Height>
              <Width>320</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.giddyup.aidv.bridge">
      <DispatchInfo>
        <Resources>
          <MainPath>./bridge.html</MainPath>
          <ScriptPath>./jsx/aidv.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>applicationActivate</Event>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size>
              <Height>1</Height>
              <Width>1</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
